---
/* Animated temporal knowledge graph: source note -> superseded fact + active fact on a time axis. */
---

<figure class="tgraph" aria-label="Diagram: A note extracts timestamped facts. Old facts are marked superseded instead of deleted, and every fact stays linked to its source.">
  <svg viewBox="0 0 360 256" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
    <!-- Source note node -->
    <rect x="64" y="10" width="232" height="44" rx="8" class="tg-card" />
    <text x="80" y="29" class="tg-kicker">SOURCE · #project-notes</text>
    <text x="80" y="45" class="tg-code">"Upgraded project to Node 26"</text>

    <!-- Extraction branches -->
    <path d="M 150 54 C 150 76, 94 74, 94 98" class="tg-edge" />
    <path d="M 210 54 C 210 76, 266 74, 266 98" class="tg-edge tg-edge-live" />

    <!-- Past fact node -->
    <rect x="14" y="98" width="156" height="74" rx="10" class="tg-card" />
    <rect x="86" y="106" width="76" height="17" rx="4" class="tg-stamp-bg" />
    <text x="124" y="117.5" text-anchor="middle" class="tg-stamp">SUPERSEDED</text>
    <text x="26" y="142" class="tg-old">Uses Node 22</text>
    <line x1="25" y1="138" x2="112" y2="138" class="tg-strike" />
    <text x="26" y="160" class="tg-date">Feb 11 → Oct 8</text>

    <!-- Arrow from old to new -->
    <line x1="170" y1="135" x2="190" y2="135" class="tg-replace" />

    <!-- Active fact node -->
    <rect x="190" y="98" width="156" height="74" rx="10" class="tg-now" />
    <circle cx="204" cy="115" r="4" class="tg-dot" />
    <text x="214" y="118.5" class="tg-live">ACTIVE</text>
    <text x="202" y="142" class="tg-new">Uses Node 26</text>
    <text x="202" y="160" class="tg-date">Oct 8 → now</text>

    <!-- Time axis at bottom -->
    <line x1="24" y1="214" x2="336" y2="214" class="tg-axis" />
    <line x1="94" y1="172" x2="94" y2="214" class="tg-drop" />
    <line x1="266" y1="172" x2="266" y2="214" class="tg-drop tg-drop-live" />
    <circle cx="94" cy="214" r="4" class="tg-tick" />
    <circle cx="266" cy="214" r="4" class="tg-tick tg-tick-live" />

    <!-- Animated scanning playhead along time axis -->
    <g class="tg-scan">
      <line x1="0" y1="198" x2="0" y2="224" stroke="var(--accent)" stroke-width="2" />
      <circle cx="0" cy="214" r="5" fill="var(--accent)" stroke="var(--raised)" stroke-width="2" />
    </g>

    <text x="94" y="238" text-anchor="middle" class="tg-axis-lbl">Ask May → Node 22</text>
    <text x="266" y="238" text-anchor="middle" class="tg-axis-lbl tg-axis-now">Ask Nov → Node 26</text>
  </svg>
</figure>

<style>
  .tgraph {
    margin: 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 10px 8px;
  }
  .tgraph svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .tg-card {
    fill: var(--raised);
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .tg-now {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .tg-kicker {
    font: 600 9.5px/1 var(--font-mono);
    letter-spacing: 0.06em;
    fill: var(--muted);
  }
  .tg-code {
    font: 600 11px/1 var(--font-mono);
    fill: var(--fg);
  }
  .tg-stamp-bg {
    fill: var(--surface);
    stroke: var(--accent-text);
    stroke-width: 1;
  }
  .tg-stamp {
    font: 700 8.5px/1 var(--font-mono);
    letter-spacing: 0.06em;
    fill: var(--accent-text);
  }
  .tg-live {
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.08em;
    fill: var(--accent-text);
  }
  .tg-old {
    font: 600 13px/1 var(--font-body);
    fill: var(--muted);
  }
  .tg-new {
    font: 700 13.5px/1 var(--font-body);
    fill: var(--fg);
  }
  .tg-strike {
    stroke: var(--accent-text);
    stroke-width: 1.5;
  }
  .tg-date {
    font: 500 10px/1 var(--font-mono);
    fill: var(--muted);
  }
  .tg-edge {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .tg-edge-live {
    stroke: var(--accent);
    stroke-dasharray: 5 5;
    animation: tg-flow 1.6s linear infinite;
  }
  .tg-replace {
    stroke: var(--accent-text);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .tg-axis {
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tg-drop {
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .tg-drop-live {
    stroke: var(--accent);
    opacity: 0.6;
  }
  .tg-tick {
    fill: var(--raised);
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .tg-tick-live {
    stroke: var(--accent);
  }
  .tg-dot {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-pulse 2s ease-in-out infinite;
  }
  .tg-axis-lbl {
    font: 500 10px/1 var(--font-mono);
    fill: var(--muted);
  }
  .tg-axis-now {
    fill: var(--accent-text);
    font-weight: 600;
  }
  .tg-scan {
    animation: tg-sweep 5.5s ease-in-out infinite;
  }

  @keyframes tg-flow {
    from { stroke-dashoffset: 20; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes tg-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }
  @keyframes tg-sweep {
    0%, 15% { transform: translateX(94px); }
    45%, 65% { transform: translateX(266px); }
    95%, 100% { transform: translateX(94px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-edge-live, .tg-dot, .tg-scan {
      animation: none;
    }
    .tg-scan {
      transform: translateX(266px);
    }
  }
</style>
