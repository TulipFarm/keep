---
import { logos } from "../data/logos";
import { hero, sections, repo, docs, flow, does, demo, setupPrompt, where, install, faq, inside } from "../data/site";
import { sh, esc } from "../data/highlight";
import TimeMachine from "./TimeMachine.astro";
import Copy from "./Copy.astro";
import MemoryFile from "./MemoryFile.astro";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
import TemporalDiagram from "./TemporalDiagram.astro";
import HubDiagram from "./HubDiagram.astro";
import Faq from "./Faq.astro";

const s = Object.fromEntries(sections.map((x) => [x.id, x]));
const half = Math.ceil(faq.length / 2);
---

<header class="wrap top">
  <a class="brand" href="/" aria-label="Keep home"><span class="mark" aria-hidden="true"></span>Keep</a>
  <nav aria-label="Primary">
    <a href="#machine">Time machine</a>
    <a href="#install">Install</a>
    <a href="#s-status">Status</a>
    <a class="btn" href={repo}><i class="lg" aria-hidden="true" set:html={logos.GitHub[0]} />GitHub</a>
  </nav>
</header>

<section class="wrap hero">
  <p class="kicker">{hero.badge}</p>
  <div class="hero-grid">
    <h1>{hero.headline.replace(/\.$/, "")}<span class="dot">.</span></h1>
    <div>
      <p class="sub">{hero.sub}</p>
      <div class="cta">
        <Copy text={setupPrompt} label={hero.copy} aria="Copy setup prompt" fallback="Copy failed. The prompt is under Install below." class="btn primary" />
        <noscript><a class="btn primary" href="#install">See the setup prompt</a><style>.copyx { display: none !important; }</style></noscript>
        <a class="btn" href={repo}><i class="lg" aria-hidden="true" set:html={logos.GitHub[0]} />{hero.primary}</a>
      </div>
      <p class="hint">{hero.hint} <a class="link" href={docs.server}>{hero.secondary}</a></p>
    </div>
  </div>
</section>

<section class="wrap machine" id="machine" aria-labelledby="machine-h">
  <div class="machine-head">
    <div>
      <h2 id="machine-h">{demo.heading}</h2>
      <p>{demo.lead}</p>
    </div>
    <ol class="steps">{demo.steps.map((t, i) => <li><span>{i + 1}</span>{t}</li>)}</ol>
  </div>
  <div class="panel">
    <p class="ex">{demo.label}</p>
    <TimeMachine />
  </div>
  <div class="meta">
    <p>{hero.note}</p>
    <p class="badges">
      <a href={`${repo}/releases`}><img alt="Latest release" width="84" height="20" src="https://img.shields.io/github/v/release/TulipFarm/keep?sort=semver&label=release&style=flat-square" /></a>
      <a href={`${repo}/stargazers`}><img alt="GitHub stars" width="58" height="20" src="https://img.shields.io/github/stars/TulipFarm/keep?style=flat-square&logo=github" /></a>
      <a href={`${repo}/actions/workflows/ci.yml`}><img alt="CI status" width="88" height="20" src="https://img.shields.io/github/actions/workflow/status/TulipFarm/keep/ci.yml?branch=main&label=CI&style=flat-square" /></a>
      <img alt="Licence: Apache-2.0" width="122" height="20" src="https://img.shields.io/badge/license-Apache--2.0-0a0a0a?style=flat-square" />
    </p>
  </div>
</section>

<section class="wrap ww" aria-label="Compatibility">
  <div><h2>Works with</h2><ul>{hero.worksWith.map((w) => <li>{(logos[w] ?? []).map((l) => <i class="lg" aria-hidden="true" set:html={l} />)}{w}</li>)}</ul></div>
  <div><h2>Stores in</h2><ul>{hero.storesIn.map((w) => <li>{(logos[w] ?? []).map((l) => <i class="lg" aria-hidden="true" set:html={l} />)}{w}</li>)}</ul></div>
</section>

<section class="wrap sec" id="how" aria-labelledby="how-h">
  <div class="sec-head"><h2 id="how-h">How it works</h2><p>{flow.caption}</p></div>
  <ArchitectureDiagram />
  <ul class="does">{does.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ul>
</section>

<section class="wrap sec" aria-labelledby="inside-h">
  <div class="sec-head"><h2 id="inside-h">{inside.heading}</h2><p>{inside.lead}</p></div>
  <div class="bento">
    {[s.memory, s.knowledge, s.connect].map((x) => (
      <article class:list={["tile", `t-${x.id}`]} id={`s-${x.id}`}>
        <p class="eyebrow">{x.eyebrow}</p>
        <h3>{x.title}</h3>
        <p class="lead">{x.lead}</p>
        <div class="art">
          {x.id === "memory" && <MemoryFile />}
          {x.id === "knowledge" && <TemporalDiagram />}
          {x.id === "connect" && <HubDiagram />}
        </div>
        <ul class="pts">{x.points.map(([b, t]) => <li><strong>{b}</strong> {t}</li>)}</ul>
        {x.link && <a class="link" href={x.link[1]}>{x.link[0]}</a>}
      </article>
    ))}

    <article class="tile t-where" id="where">
      <p class="eyebrow">Deploy</p>
      <h3>{where.heading}</h3>
      <p class="lead">{where.lead}</p>
      <ul class="where">
        {where.items.map(([t, d, c]) => <li><strong>{t}</strong><span>{d}</span><code set:html={sh(c)} /></li>)}
      </ul>
      <a class="link" href={where.link[1]}>{where.link[0]}</a>
    </article>

    <article class="tile t-status" id="s-status">
      <div class="status-head">
        <p class="eyebrow">{s.status.eyebrow}</p>
        <span class="flag">Not passed yet</span>
      </div>
      <h3>{s.status.lead}</h3>
      <ul class="pts">{s.status.points.map(([b, t]) => <li><strong>{b}</strong> {t}</li>)}</ul>
      <dl class="log">
        <div><dt>Development runs</dt><dd class="bad">Not passed</dd></div>
        <div><dt>Sealed holdout</dt><dd>Not run</dd></div>
        <div><dt>Published results</dt><dd>None</dd></div>
      </dl>
      <a class="link" href={s.status.link![1]}>{s.status.link![0]}</a>
    </article>

    <article class="tile t-oss" id="s-open-source">
      <p class="eyebrow">{s["open-source"].eyebrow}</p>
      <h3>{s["open-source"].title}</h3>
      <p class="lead">{s["open-source"].lead}</p>
      <ul class="pts">{s["open-source"].points.map(([b, t]) => <li><strong>{b}</strong> {t}</li>)}</ul>
      <div class="oss-cta">
        <a class="btn primary" href={repo}>Read the source</a>
        <a class="btn" href={docs.issues}>Report a bug or ask for a feature</a>
        <a class="btn" href={docs.method}>Read the methodology</a>
      </div>
      <a class="link" href={s["open-source"].link![1]}>{s["open-source"].link![0]}</a>
    </article>
  </div>
</section>

<section class="band" id="install" aria-labelledby="install-h">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="install-h">{install.heading}</h2>
      <p>{install.lead}</p>
    </div>
    <div class="band-grid">
      {[install.agent, install.script].map((c, i) => (
        <div class="cmdbox">
          <h3><span aria-hidden="true">{i === 0 ? "A" : "B"}</span>{c.title}</h3>
          <p>{c.note}</p>
          <div class="cmd">
            <pre><code set:html={c === install.script ? sh(c.cmd) : esc(c.cmd)} /></pre>
            <Copy text={c.cmd} label={install.copy} aria={`Copy: ${c.title}`} class={i === 0 ? "btn primary" : "btn ghost"} />
          </div>
        </div>
      ))}
    </div>
    <p class="band-links">{install.links.map(([t, h]) => <a href={h}>{t}</a>)}</p>
  </div>
</section>

<section class="wrap sec questions" aria-labelledby="faq-h">
  <h2 id="faq-h">Questions</h2>
  <div class="faq-grid">
    <Faq items={faq.slice(0, half)} />
    <Faq items={faq.slice(half)} />
  </div>
</section>

<style>
  .lg { display: inline-flex; margin-right: 6px; }
  .lg :global(svg) { width: 1em; height: 1em; }

  .top { display: flex; justify-content: space-between; align-items: center; height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; text-decoration: none; letter-spacing: -.02em; }
  .mark { width: 14px; height: 14px; border-radius: 3px; background: var(--accent); box-shadow: 5px 5px 0 -1px var(--fg); }
  .top nav { display: flex; align-items: center; gap: 28px; font-size: .94rem; }
  .top nav a:not(.btn) { color: var(--muted); text-decoration: none; }
  .top nav a:not(.btn):hover { color: var(--fg); }

  .hero { padding: 72px 0 48px; }
  .kicker { font: 500 .8rem var(--font-mono); color: var(--muted); margin-bottom: 20px; }
  .hero-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; align-items: end; }
  .hero h1 { text-wrap: wrap; }
  .dot { color: var(--accent); }
  .sub { margin-bottom: 24px; color: var(--muted); font-size: 1.1rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
  .hint { color: var(--muted); font-size: .9rem; }
  .hint .link { margin-left: 4px; }

  .machine { padding-bottom: 24px; }
  .machine-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding: 20px 0; border-top: 2px solid var(--fg); }
  .machine-head h2 { font-size: 1.25rem; letter-spacing: -.02em; }
  .machine-head p { margin-top: 4px; color: var(--muted); max-width: 60ch; }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; color: var(--muted); font-size: .9rem; flex-shrink: 0; }
  .steps li { display: flex; align-items: center; gap: 8px; }
  .steps span { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--surface); border: 1px solid var(--line); font: 600 .72rem var(--font-mono); color: var(--fg); }
  .panel { position: relative; padding: 36px 36px 28px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .ex { position: absolute; top: 14px; right: 18px; font: 500 .72rem var(--font-mono); color: var(--muted); }
  .meta { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 16px; color: var(--muted); font-size: .9rem; }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .badges img { display: block; width: auto; }

  .ww { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; padding: 48px 0; border-bottom: 1px solid var(--line); }
  .ww h2 { margin-bottom: 12px; font: 600 .75rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .ww ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-weight: 600; }
  .ww li { display: inline-flex; align-items: center; }

  .sec { padding-top: 96px; }
  .sec-head { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 40px; }
  .sec-head p { color: var(--muted); }

  .does { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .does li { padding-top: 16px; border-top: 2px solid var(--fg); }
  .does h3 { margin-bottom: 6px; font-size: 1.05rem; }
  .does p { color: var(--muted); font-size: .95rem; }

  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; grid-template-areas: "mem mem know" "conn where know" "status status oss"; }
  .tile { display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 28px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .tile h3 { font-size: 1.45rem; line-height: 1.15; }
  .tile > .link { margin-top: auto; padding-top: 4px; }
  .t-memory { grid-area: mem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); grid-template-rows: auto auto auto 1fr; column-gap: 32px; row-gap: 12px; }
  .t-memory > :not(.art) { grid-column: 1; }
  .t-memory .art { grid-column: 2; grid-row: 1 / span 5; align-self: center; }
  .t-memory > .link { align-self: end; }
  .t-knowledge { grid-area: know; }
  .t-connect { grid-area: conn; }
  .t-where { grid-area: where; }
  .t-status { grid-area: status; }
  .t-oss { grid-area: oss; }
  .lead { color: var(--muted); }
  .art { margin: 4px 0; min-width: 0; }
  .art :global(.eyebrow) { color: var(--muted); }
  .pts { list-style: none; margin: 0; padding: 0; font-size: .93rem; color: var(--muted); }
  .pts li { padding: 8px 0; border-top: 1px solid var(--line); }
  .pts strong { color: var(--fg); font-weight: 600; }

  .where { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .where li { display: grid; gap: 2px; padding: 12px 14px; background: var(--raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .where strong { font-size: .95rem; }
  .where span { color: var(--muted); font-size: .88rem; }
  .where code { margin-top: 6px; font-size: .8rem; overflow-wrap: anywhere; }

  .status-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .flag { display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); font: 600 .75rem var(--font-mono); white-space: nowrap; }
  .flag::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .t-status h3 { max-width: 30ch; }
  .log { margin: 4px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .log div { padding: 12px 14px; background: var(--raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .log dt { font: .72rem var(--font-mono); color: var(--muted); }
  .log dd { margin: 4px 0 0; font-weight: 650; }
  .log dd.bad { color: var(--accent-text); }
  .oss-cta { display: flex; flex-wrap: wrap; gap: 8px; }
  .oss-cta .btn { min-height: 40px; padding: 0 14px; font-size: .88rem; text-align: center; }

  .band { margin-top: 96px; padding: 88px 0; background: var(--band); color: var(--band-fg); border-block: 1px solid var(--band-line); }
  .band h2, .band h3 { color: var(--band-fg); }
  .band .sec-head p, .cmdbox p { color: var(--band-muted); }
  .band-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cmdbox { padding: 24px; border: 1px solid var(--band-line); border-radius: var(--radius-lg); display: flex; flex-direction: column; gap: 10px; }
  .cmdbox h3 { display: flex; align-items: center; gap: 10px; font-size: 1.1rem; }
  .cmdbox h3 span { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink); font: 700 .75rem var(--font-mono); }
  .cmdbox p { font-size: .93rem; flex: 1; }
  .cmd { display: flex; gap: 8px; align-items: stretch; margin-top: 6px; }
  .cmd pre { flex: 1; min-width: 0; margin: 0; padding: 12px 14px; background: var(--band-code); border: 1px solid var(--band-line); border-radius: var(--radius); font: .82rem/1.5 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  .cmd :global(.btn) { height: auto; }
  .cmd :global(.btn.ghost) { background: transparent; color: var(--band-fg); border-color: var(--band-line); }
  @media (hover: hover) and (pointer: fine) { .cmd :global(.btn.ghost:hover) { border-color: var(--band-fg); } }
  .band-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 28px; }
  .band-links a { font-weight: 500; text-decoration-color: var(--band-muted); }
  .band-links a:hover { text-decoration-color: var(--accent); }

  .questions { padding-bottom: 96px; }
  .questions h2 { margin-bottom: 24px; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; align-items: start; }

  @media (max-width: 1000px) {
    .hero-grid, .sec-head, .ww { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "mem mem" "know conn" "know where" "status status" "oss oss"; }
    .machine-head { flex-direction: column; align-items: start; gap: 12px; }
    .steps { flex-wrap: wrap; gap: 8px 20px; }
  }
  @media (max-width: 720px) {
    .top nav a:not(.btn) { display: none; }
    .hero { padding: 40px 0 32px; }
    .panel { padding: 40px 16px 20px; border-radius: 12px; }
    .does, .band-grid, .faq-grid, .log { grid-template-columns: minmax(0, 1fr); }
    .bento { grid-template-columns: minmax(0, 1fr); grid-template-areas: "mem" "know" "conn" "where" "status" "oss"; }
    .t-memory { display: flex; }
    .tile { padding: 20px; }
    .sec { padding-top: 64px; }
    .band { margin-top: 64px; padding: 56px 0; }
    .cmd { flex-direction: column; }
  }
</style>
