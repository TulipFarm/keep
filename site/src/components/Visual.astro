---
import { repo, docs } from "../data/site";
import MemoryFile from "./MemoryFile.astro";
import Facts from "./Facts.astro";
import Snippet from "./Snippet.astro";
const { id } = Astro.props;
---

{id === "memory" && <MemoryFile />}
{id === "knowledge" && <Facts />}
{id === "connect" && <Snippet />}
{id === "status" && (
  <div class="card" style="display:grid;gap:10px">
    <span class="stamp" style="justify-self:start">Not passed yet</span>
    <p class="mono">development runs: NOT PASSED<br />sealed holdout: not run<br />published results: none</p>
  </div>
)}
{id === "open-source" && (
  <div style="display:flex;flex-wrap:wrap;gap:12px">
    <a class="btn primary" href={repo}>Read the source</a>
    <a class="btn" href={docs.issues}>Report a bug or ask for a feature</a>
    <a class="btn" href={docs.method}>Read the methodology</a>
  </div>
)}
