---
/* Animated isometric overview of how Keep connects AI tools to versioned Memory + Temporal Knowledge. */
---

<figure class="arch" aria-label="Diagram: AI tools connect to Keep's versioned Memory and Temporal Knowledge layers, returning grounded answers with sources.">
  <svg viewBox="0 0 960 350" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
    <defs>
      <pattern id="iso-grid" width="32" height="32" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" fill="var(--line-strong)" opacity="0.45" />
      </pattern>
    </defs>

    <!-- Subtle technical dot grid -->
    <rect x="0" y="0" width="960" height="350" rx="14" fill="url(#iso-grid)" />

    <!-- Column headers -->
    <text x="115" y="34" text-anchor="middle" class="lbl">1. YOUR AI TOOLS</text>
    <text x="480" y="34" text-anchor="middle" class="lbl lbl-accent">2. KEEP (ON YOUR MACHINE)</text>
    <text x="830" y="34" text-anchor="middle" class="lbl">3. GROUNDED CONTEXT</text>

    <!-- Animated flow lines: Clients -> Keep Core -->
    <path d="M 196 105 C 260 105, 295 148, 362 148" class="pipe-bg" />
    <path d="M 196 105 C 260 105, 295 148, 362 148" class="pipe-flow" />

    <path d="M 196 185 C 260 185, 295 185, 354 185" class="pipe-bg" />
    <path d="M 196 185 C 260 185, 295 185, 354 185" class="pipe-flow pipe-d2" />

    <path d="M 196 265 C 260 265, 295 225, 362 225" class="pipe-bg" />
    <path d="M 196 265 C 260 265, 295 225, 362 225" class="pipe-flow pipe-d3" />

    <!-- Animated flow lines: Keep Core -> Grounded Output -->
    <path d="M 598 148 C 655 148, 668 142, 718 142" class="pipe-bg" />
    <path d="M 598 148 C 655 148, 668 142, 718 142" class="pipe-flow pipe-out" />

    <path d="M 598 225 C 655 225, 668 228, 718 228" class="pipe-bg" />
    <path d="M 598 225 C 655 225, 668 228, 718 228" class="pipe-flow pipe-out pipe-d2" />

    <!-- Moving packets (CSS offset-path) -->
    <circle r="4" class="pkt pkt-1" />
    <circle r="4" class="pkt pkt-2" />
    <circle r="4" class="pkt pkt-3" />
    <circle r="4" class="pkt pkt-4" />

    <!-- LEFT: 3 AI client cards -->
    <g transform="translate(36, 76)">
      <rect width="160" height="58" rx="10" class="card-fill" />
      <circle cx="24" cy="29" r="5" class="dot-accent" />
      <text x="40" y="26" class="node-title">Claude</text>
      <text x="40" y="43" class="node-sub">Code &amp; Desktop</text>
    </g>

    <g transform="translate(36, 156)">
      <rect width="160" height="58" rx="10" class="card-fill" />
      <circle cx="24" cy="29" r="5" class="dot-muted" />
      <text x="40" y="26" class="node-title">Codex</text>
      <text x="40" y="43" class="node-sub">MCP · stdio</text>
    </g>

    <g transform="translate(36, 236)">
      <rect width="160" height="58" rx="10" class="card-fill" />
      <circle cx="24" cy="29" r="5" class="dot-muted" />
      <text x="40" y="26" class="node-title">Copilot / Cursor</text>
      <text x="40" y="43" class="node-sub">Shared workspace</text>
    </g>

    <!-- CENTER: Isometric 2-layer Keep Vault -->
    <g class="iso-stack">
      <!-- Ground shadow ring -->
      <polygon points="480,318 602,262 480,206 358,262" class="iso-shadow" />

      <!-- Bottom Isometric Slab: TEMPORAL KNOWLEDGE -->
      <g class="slab-bottom">
        <!-- Left vertical face -->
        <polygon points="356,236 480,292 480,310 356,254" class="iso-side-l" />
        <!-- Right vertical face -->
        <polygon points="480,292 604,236 604,254 480,310" class="iso-side-r" />
        <!-- Top face -->
        <polygon points="480,180 604,236 480,292 356,236" class="iso-top" />
        <!-- Inner timeline track on top face -->
        <line x1="414" y1="236" x2="546" y2="236" class="iso-track" />
        <circle cx="448" cy="236" r="4.5" class="dot-past" />
        <circle cx="516" cy="236" r="5.5" class="dot-accent pulse-dot" />
        <!-- Label -->
        <text x="480" y="218" text-anchor="middle" class="iso-title">TEMPORAL FACTS</text>
        <text x="480" y="264" text-anchor="middle" class="iso-sub">valid_at · sources</text>
      </g>

      <!-- Vertical sync beams between slabs -->
      <line x1="444" y1="176" x2="444" y2="212" class="sync-beam" />
      <line x1="516" y1="176" x2="516" y2="212" class="sync-beam sync-d2" />

      <!-- Top Isometric Slab: MEMORY (Versioned Notes) -->
      <g class="slab-top">
        <!-- Left vertical face -->
        <polygon points="356,136 480,192 480,210 356,154" class="iso-side-l accent-side-l" />
        <!-- Right vertical face -->
        <polygon points="480,192 604,136 604,154 480,210" class="iso-side-r accent-side-r" />
        <!-- Top face -->
        <polygon points="480,80 604,136 480,192 356,136" class="iso-top accent-top" />
        <!-- Version pills on top face -->
        <g transform="translate(422, 125)">
          <rect x="0" y="0" width="32" height="18" rx="4" class="rev-pill" />
          <text x="16" y="12.5" text-anchor="middle" class="rev-txt">r1</text>
          <rect x="42" y="0" width="32" height="18" rx="4" class="rev-pill" />
          <text x="58" y="12.5" text-anchor="middle" class="rev-txt">r2</text>
          <rect x="84" y="0" width="32" height="18" rx="4" class="rev-pill rev-now" />
          <text x="100" y="12.5" text-anchor="middle" class="rev-txt rev-now-txt">r3</text>
        </g>
        <!-- Label -->
        <text x="480" y="114" text-anchor="middle" class="iso-title">MEMORY NOTES</text>
        <text x="480" y="159" text-anchor="middle" class="iso-sub">Markdown · versioned</text>
      </g>
    </g>

    <!-- RIGHT: Grounded Context & Receipts card -->
    <g transform="translate(718, 76)">
      <rect width="212" height="218" rx="12" class="card-fill" />
      <text x="18" y="28" class="lbl">RETURNED TO AGENT</text>

      <!-- Active fact -->
      <rect x="16" y="42" width="180" height="58" rx="8" class="out-now" />
      <circle cx="30" cy="62" r="4" class="dot-accent pulse-dot" />
      <text x="42" y="66" class="out-main">Uses Node 26</text>
      <text x="42" y="85" class="out-meta">Oct 8 → now · Active</text>

      <!-- Superseded fact -->
      <rect x="16" y="110" width="180" height="54" rx="8" class="out-past" />
      <text x="28" y="133" class="out-struck">Uses Node 22</text>
      <line x1="26" y1="129" x2="118" y2="129" class="strike-line" />
      <text x="28" y="151" class="out-meta">Superseded · still kept</text>

      <!-- Receipt footer -->
      <line x1="16" y1="178" x2="196" y2="178" stroke="var(--line)" />
      <text x="18" y="199" class="out-src">↗ Source: #project-notes</text>
    </g>
  </svg>
</figure>

<style>
  .arch {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 16px;
    overflow: hidden;
  }
  .arch svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .lbl {
    font: 600 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    fill: var(--muted);
  }
  .lbl-accent {
    fill: var(--accent-text);
  }

  .card-fill {
    fill: var(--raised);
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .node-title {
    font: 700 14px/1 var(--font-body);
    fill: var(--fg);
  }
  .node-sub {
    font: 500 11px/1 var(--font-mono);
    fill: var(--muted);
  }
  .dot-accent {
    fill: var(--accent);
  }
  .dot-muted {
    fill: var(--line-strong);
  }
  .dot-past {
    fill: var(--raised);
    stroke: var(--muted);
    stroke-width: 1.5;
  }

  /* Isometric slabs */
  .iso-shadow {
    fill: var(--line);
    opacity: 0.45;
  }
  .iso-top {
    fill: var(--raised);
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }
  .iso-side-l {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }
  .iso-side-r {
    fill: var(--line);
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }
  .accent-top {
    fill: var(--raised);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .accent-side-l {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.25;
  }
  .accent-side-r {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 1.25;
  }
  .iso-title {
    font: 700 11.5px/1 var(--font-mono);
    letter-spacing: 0.06em;
    fill: var(--fg);
  }
  .iso-sub {
    font: 500 10.5px/1 var(--font-mono);
    fill: var(--muted);
  }
  .iso-track {
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rev-pill {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .rev-now {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .rev-txt {
    font: 600 10px/1 var(--font-mono);
    fill: var(--muted);
  }
  .rev-now-txt {
    fill: var(--accent-ink);
  }

  /* Right output card */
  .out-now {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1;
  }
  .out-past {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }
  .out-main {
    font: 700 13.5px/1 var(--font-body);
    fill: var(--fg);
  }
  .out-struck {
    font: 600 13px/1 var(--font-body);
    fill: var(--muted);
  }
  .strike-line {
    stroke: var(--accent-text);
    stroke-width: 1.5;
  }
  .out-meta {
    font: 500 10.5px/1 var(--font-mono);
    fill: var(--muted);
  }
  .out-src {
    font: 600 11px/1 var(--font-mono);
    fill: var(--accent-text);
  }

  /* Animated signal pipes */
  .pipe-bg {
    stroke: var(--line);
    stroke-width: 2;
  }
  .pipe-flow {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 6 10;
    stroke-linecap: round;
    opacity: 0.7;
    animation: flow 1.8s linear infinite;
  }
  .pipe-d2 {
    animation-delay: -0.6s;
  }
  .pipe-d3 {
    animation-delay: -1.2s;
  }
  .pipe-out {
    animation-duration: 1.5s;
  }

  .sync-beam {
    stroke: var(--accent-text);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    animation: sync-down 1.4s linear infinite;
  }
  .sync-d2 {
    animation-delay: -0.7s;
  }

  /* Moving data packets along the curves */
  .pkt {
    fill: var(--accent);
    offset-rotate: 0deg;
    animation: travel 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .pkt-1 {
    offset-path: path("M 196 105 C 260 105, 295 148, 362 148");
  }
  .pkt-2 {
    offset-path: path("M 196 185 C 260 185, 295 185, 354 185");
    animation-delay: -0.9s;
  }
  .pkt-3 {
    offset-path: path("M 196 265 C 260 265, 295 225, 362 225");
    animation-delay: -1.8s;
  }
  .pkt-4 {
    offset-path: path("M 598 148 C 655 148, 668 142, 718 142");
    animation-duration: 2.2s;
    animation-delay: -0.4s;
  }

  /* Gentle isometric float on top slab */
  .slab-top {
    animation: float-slab 4.5s ease-in-out infinite;
  }

  .pulse-dot {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes flow {
    from { stroke-dashoffset: 32; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes sync-down {
    from { stroke-dashoffset: 16; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes float-slab {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-5px); }
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipe-flow, .sync-beam, .pkt, .slab-top, .pulse-dot {
      animation: none;
    }
    .pkt {
      display: none;
    }
  }
</style>
