---
import { fandom } from "../data/site";
import "../styles/hp-graph.css";
---
<div class="hpg-stats" id="hpg-stats"></div>
<div class="hpg">
  <div class="hpg-canvas wait" id="hpg-canvas"></div>
  <div class="hpg-card" id="hpg-card" hidden></div>
  <p class="hpg-hint">{fandom.hint}</p>
</div>
<p class="hpg-credit" id="hpg-credit"></p>

<script>
  import { card, counts, credit, loadDemo, mount, whenVisible } from "../scripts/hp-graph";
  const el = document.getElementById("hpg-canvas")!;
  const box = document.getElementById("hpg-card")!;
  whenVisible(el, async () => {
    const data = await loadDemo();
    el.classList.remove("wait");
    const c = counts(data);
    document.getElementById("hpg-stats")!.innerHTML = [[c.entities, "things"], [c.facts, "facts"], [c.sources, "wiki pages"], [c.clusters, "clusters"]]
      .map(([n, l]) => `<div><strong>${n.toLocaleString()}</strong><span>${l}</span></div>`).join("");
    document.getElementById("hpg-credit")!.innerHTML = credit(data);
    const viewer = mount(el, data, (n) => {
      box.hidden = !n;
      if (n) box.innerHTML = `<button class="x" type="button" aria-label="Close">×</button>` + card(viewer, n);
    });
    box.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.dataset.go) viewer.select(t.dataset.go);
      if (t.classList.contains("x")) viewer.select(null);
    });
  });
</script>
