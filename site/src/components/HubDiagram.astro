---
/* Animated isometric local-first MCP hub diagram for the Connect tile. */
---

<figure class="hub" aria-label="Diagram: Claude, Codex, Copilot, and Cursor connect over local MCP to Keep running on your machine at 127.0.0.1 with no cloud API.">
  <svg viewBox="0 0 340 210" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
    <!-- Local machine boundary -->
    <rect x="8" y="8" width="324" height="194" rx="12" class="hub-box" />
    <text x="20" y="26" class="hub-kicker">YOUR MACHINE · 127.0.0.1</text>
    <rect x="234" y="14" width="88" height="18" rx="9" class="hub-badge" />
    <text x="278" y="26" text-anchor="middle" class="hub-badge-txt">NO CLOUD API</text>

    <!-- Animated MCP connectors from 4 tools to center cube -->
    <path d="M 88 64 L 146 96" class="hub-wire" />
    <path d="M 252 64 L 194 96" class="hub-wire hub-d2" />
    <path d="M 88 152 L 146 128" class="hub-wire hub-d3" />
    <path d="M 252 152 L 194 128" class="hub-wire hub-d4" />

    <!-- Center isometric Keep cube -->
    <g class="hub-cube" transform="translate(170, 108)">
      <polygon points="0,-28 32,-12 0,4 -32,-12" class="cube-top" />
      <polygon points="-32,-12 0,4 0,30 -32,14" class="cube-left" />
      <polygon points="0,4 32,-12 32,14 0,30" class="cube-right" />
      <text x="0" y="-9" text-anchor="middle" class="cube-txt">KEEP</text>
    </g>

    <!-- 4 AI tool pills -->
    <g transform="translate(22, 46)">
      <rect width="74" height="32" rx="7" class="tool-pill" />
      <text x="37" y="20" text-anchor="middle" class="tool-txt">Claude</text>
    </g>
    <g transform="translate(244, 46)">
      <rect width="74" height="32" rx="7" class="tool-pill" />
      <text x="37" y="20" text-anchor="middle" class="tool-txt">Codex</text>
    </g>
    <g transform="translate(22, 136)">
      <rect width="74" height="32" rx="7" class="tool-pill" />
      <text x="37" y="20" text-anchor="middle" class="tool-txt">Copilot</text>
    </g>
    <g transform="translate(244, 136)">
      <rect width="74" height="32" rx="7" class="tool-pill" />
      <text x="37" y="20" text-anchor="middle" class="tool-txt">Cursor</text>
    </g>

    <!-- Protocol label -->
    <text x="170" y="191" text-anchor="middle" class="hub-proto">MCP (stdio) · Scoped key per tool</text>
  </svg>
</figure>

<style>
  .hub {
    margin: 0;
  }
  .hub svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .hub-box {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .hub-kicker {
    font: 600 9.5px/1 var(--font-mono);
    letter-spacing: 0.06em;
    fill: var(--muted);
  }
  .hub-badge {
    fill: var(--ok-soft);
  }
  .hub-badge-txt {
    font: 700 8.5px/1 var(--font-mono);
    letter-spacing: 0.05em;
    fill: var(--ok);
  }
  .hub-wire {
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-dasharray: 4 6;
    stroke-linecap: round;
    animation: hub-flow 1.6s linear infinite;
  }
  .hub-d2 { animation-delay: -0.4s; }
  .hub-d3 { animation-delay: -0.8s; }
  .hub-d4 { animation-delay: -1.2s; }

  .hub-cube {
    animation: cube-bob 4s ease-in-out infinite;
  }
  .cube-top {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .cube-left {
    fill: var(--raised);
    stroke: var(--accent);
    stroke-width: 1.3;
  }
  .cube-right {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 1.3;
  }
  .cube-txt {
    font: 700 9.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    fill: var(--fg);
  }

  .tool-pill {
    fill: var(--raised);
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .tool-txt {
    font: 600 12px/1 var(--font-body);
    fill: var(--fg);
  }
  .hub-proto {
    font: 500 10px/1 var(--font-mono);
    fill: var(--muted);
  }

  @keyframes hub-flow {
    from { stroke-dashoffset: 20; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes cube-bob {
    0%, 100% { transform: translate(170px, 108px); }
    50% { transform: translate(170px, 103px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-wire, .hub-cube {
      animation: none;
    }
  }
</style>
