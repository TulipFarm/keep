{
  "name": "keep-dev-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --format=esm --target=es2022 --legal-comments=eof --outfile=dist/graph.js",
    "dev": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/graph.js --servedir=. --watch",
    "check": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "graphology-types": "^0.24.8",
    "typescript": "^5.9.0"
  }
}
